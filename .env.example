TS3_IMAGE=teamspeak:3.13.8
TS3_IMAGE_FALLBACKS=docker.m.daocloud.io/library/teamspeak:3.13.8
# The default official image is currently linux/amd64.
# ARM hosts need TS3_IMAGE to point at a compatible image.
TS3_COMPOSE_PROJECT=teamspeak3
TS3_CONTAINER_NAME=teamspeak3
TS3_VOICE_PORT=9987
TS3_QUERY_PORT=10011
TS3_QUERY_BIND=127.0.0.1
TS3_FILE_PORT=30033
TS3_DATA_DIR=/opt/teamspeak3-docker/data
TS3_CONTAINER_UID=9987
TS3_CONTAINER_GID=9987
# Optional. Do not commit real passwords.
# TS3_SERVER_PASSWORD=change-me
